# Copy this to .env.local (or .env) and fill values for local development

# Backend API base (FastAPI) - default is http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Optional Groq key — chat uses the backend /chat endpoint first; Groq is a fallback
VITE_GROQ_KEY=YOUR_CHAT_API_KEY_HERE
# Legacy alias (also supported)
# VITE_GROQ_API=YOUR_CHAT_API_KEY_HERE

# Firebase (client-side) - required for Google sign-in and Firestore features
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Notes:
# - After creating the file, restart the dev server.
# - For Google sign-in locally, open the app at http://localhost:5173 (not 127.0.0.1).
# - In Firebase Console -> Authentication -> Sign-in method: enable Google.
# - In Authentication -> Settings -> Authorized domains: ensure `localhost` is listed (add your production domain when deploying).
# - Do NOT commit real secret keys to version control. Use environment-specific secrets in CI/deploy.
